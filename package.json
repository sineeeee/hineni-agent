{
  "name": "hineni-agent",
  "version": "0.1.0",
  "description": "Four-layer personal agent runtime",
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "init": "node --import tsx src/main.ts init",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"docs/**/*.md\" README.md",
    "docs": "node --import tsx scripts/generate-docs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.52",
    "cron-parser": "^5.10.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^9.1.0",
    "js-tiktoken": "^1.0.21",
    "node-fetch": "^3.3.2",
    "openai": "^7.47.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "undici": "^8.12.2",
    "minimatch": "^11.0.1"
  }
}
